# A builder for x86_64 Linux desktops.
#
# Debian bullseye with the X11, Wayland, GL, sound and input development
# packages SDL3 builds against (it loads each of them at run time).  The
# result runs on glibc 2.31 and later, so on any current desktop.
FROM debian:bullseye

# bullseye is past its end of life: its packages are on the archive now
RUN rm -f /etc/apt/sources.list.d/* && \
    printf '%s\n' \
      'deb http://archive.debian.org/debian bullseye main' \
      'deb http://archive.debian.org/debian bullseye-updates main' \
      'deb http://archive.debian.org/debian-security bullseye-security main' \
      > /etc/apt/sources.list

RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        ca-certificates git make cmake ninja-build pkg-config file zip \
        build-essential \
        libx11-dev libxext-dev libxrandr-dev libxcursor-dev libxi-dev \
        libxfixes-dev libxss-dev libxtst-dev libxkbcommon-dev \
        libwayland-dev wayland-protocols libwayland-bin \
        libgl-dev libegl-dev libgles-dev libdrm-dev libgbm-dev \
        libasound2-dev libpulse-dev libpipewire-0.3-dev \
        libudev-dev libdbus-1-dev && \
    rm -rf /var/lib/apt/lists/*
